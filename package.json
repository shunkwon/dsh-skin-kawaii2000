{
  "name": "dsh-skin-kawaii2000",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shunkwon/dsh-skin-kawaii2000.git"
  },
  "description": "dsh 皮肤 糖果毛玻璃 —— 饱和糖果桌面 + 乳白毛玻璃窗(backdrop-filter + 双层亮边 + 有色柔光 + 四档圆角)，白天/夜间两套配方",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
